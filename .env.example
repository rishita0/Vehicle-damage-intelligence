# ─────────────────────────────────────────────
# AI Vehicle Damage Intelligence Pipeline
# Environment Configuration
# ─────────────────────────────────────────────

# Ollama Config (fully local LLM — no API key needed)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB=vehicle_damage_db
MONGO_COLLECTION=damage_predictions

# ChromaDB (local, no key needed)
CHROMA_PERSIST_DIR=./data/chromadb

# Flask Config
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=your_secret_key_here

# Model Config
MODEL_PATH=./models/damage_classifier.h5
CONFIDENCE_THRESHOLD=0.60
IMAGE_SIZE=224

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG Config
RAG_TOP_K=3
MAX_REPORT_TOKENS=800
